# ─── Copiez ce fichier en « .env » pour le développement local. ───
# ─── Sur Render, saisissez ces variables dans Environment (jamais dans GitHub). ───

NODE_ENV=development
PORT=5000

# MongoDB Atlas — chaîne de connexion complète, avec le nom de base (ex. .../gnah?retryWrites=true&w=majority)
MONGODB_URI=

# Longue chaîne aléatoire (32 caractères minimum). Pour en générer une :
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Adresse(s) du site public autorisée(s) à lire l'API (séparées par des virgules, sans « / » final)
FRONTEND_ORIGIN=http://localhost:3000

# Adresse publique de l'API (qui sert aussi l'espace d'administration)
API_PUBLIC_ORIGIN=http://localhost:5000

# strict (recommandé), lax ou none
COOKIE_SAMESITE=strict

# Cloudinary (Dashboard > API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Premier administrateur : créé automatiquement au démarrage UNIQUEMENT s'il n'en existe aucun.
# Mot de passe : 12 caractères minimum, majuscule, minuscule, chiffre et symbole.
# Une fois connecté, retirez ces deux variables.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Synchronisation sans perte au démarrage (laisser vide ; « false » pour la désactiver)
# SYNC_ON_START=
