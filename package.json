{
  "name": "gnah-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API sécurisée — Groupe Ndoye Africa Holding (administration, contenu, médias)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "sync": "node script/sync.js",
    "sync:check": "node script/sync.js --dry-run",
    "import-site-data": "node script/import-site-data.js",
    "backup": "node script/backup.js",
    "create-admin": "node script/createAdmin.js",
    "smoke-test": "node script/smoke-test.js",
    "test": "node --test test/syncPlan.test.js test/legacyImport.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.7.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5"
  }
}
